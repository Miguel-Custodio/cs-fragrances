{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    { "source": "/b2b", "destination": "/business", "permanent": true },
    { "source": "/b2b/:path*", "destination": "/business/:path*", "permanent": true }
  ]
}
