# ---------------------------------------------------------------------------
# Copy to .env for local use. NEVER commit real secrets (.env is git-ignored).
# On Vercel: Project -> Settings -> Environment Variables.
# On Cloudflare Pages: Settings -> Variables and Secrets.
# ---------------------------------------------------------------------------

# --- Server-side (checkout function: api/checkout.ts / functions/api/checkout.ts) ---
# Square Developer Dashboard -> your application -> Credentials / Locations.
# Use the SANDBOX token+location for Preview/testing and the PRODUCTION ones only for Production.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# sandbox | production  (defaults to sandbox when empty)
SQUARE_ENVIRONMENT=sandbox
# Optional: pin a Square API version (default is set in shared/checkout.ts)
# SQUARE_API_VERSION=
# Public site URL used for the "back to the shop" redirect after payment
SITE_URL=https://www.csfragrances.ca
# Set to true ONLY after the real shipping rates in shared/shipping.ts are filled in.
# While not "true", checkout falls back to a WhatsApp order.
SHIPPING_RATES_CONFIRMED=true  # rates approved by Miguel 2026-11-19
# BC GST 5% + PST 7%. Keep false until GST/PST registration is confirmed (CRA rules).
# Must match VITE_TAX_ENABLED below.
TAX_ENABLED=false
# Allow gift kits to be sold. Keep false until the kits are approved. Must match VITE_KITS_ENABLED.
KITS_ENABLED=false

# --- Build-time, exposed to the browser (never put secrets here) ---
VITE_TAX_ENABLED=false
VITE_KITS_ENABLED=false
VITE_APP_TITLE=CS Fragrances
